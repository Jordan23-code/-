# 不動産情報ライブラリ(国土交通省)のAPIキー。
# https://www.reinfolib.mlit.go.jp/api/request/ で個人申請(無料・5営業日程度)
REINFOLIB_API_KEY=

# Google Gemini APIキー(記事の文章生成に使用。無料枠あり・カード登録不要)
# https://aistudio.google.com/apikey で取得してください
GEMINI_API_KEY=

# 使用するGeminiモデル(省略時は gemini-3.6-flash)
# GEMINI_MODEL=gemini-3.6-flash

# Pexels APIキー(記事のイメージ写真に使用。任意・無料・審査不要・カード登録不要)
# https://www.pexels.com/api/ で取得してください。未設定の場合は画像なしで記事が生成されます。
PEXELS_API_KEY=
